# =============================================================================
# VoxSearch — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in REAL values only in your local,
# untracked environment. NEVER commit real credentials or secrets.
# All values below are PLACEHOLDERS — none are real secrets.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --- Database (PostgreSQL / pgvector) ---
DATABASE_URL=postgresql://your-user:your-password@your-host:5432/your-database

# --- YouTube Data API ---
YOUTUBE_API_KEY=your-youtube-api-key-placeholder

# --- Redis (queue / cache) ---
REDIS_URL=redis://your-redis-host:6379/0

# --- ML models (planned; e.g. BAAI/bge-m3, BAAI/bge-reranker-v2-m3) ---
EMBEDDING_MODEL=your-embedding-model-name-placeholder
RERANKER_MODEL=your-reranker-model-name-placeholder
