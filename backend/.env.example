# =============================================================================
# VoxSearch backend — environment configuration template
# =============================================================================
# Copy to `.env` for local overrides:  copy .env.example .env
# These are non-secret settings with safe defaults in app/core/config.py.
# NEVER put credentials, API keys, or secrets in this file.
# =============================================================================

# Service identity (also used for the /health "service" field and app metadata)
APP_NAME=voxsearch-backend

# Runtime environment: development | staging | production
APP_ENV=development

# Semantic version exposed by /health and OpenAPI
APP_VERSION=0.1.0

# Prefix reserved for future versioned API routers (e.g. /api/v1/search)
API_PREFIX=/api/v1

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
