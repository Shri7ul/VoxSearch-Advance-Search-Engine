# =============================================================================
# VoxSearch backend — environment configuration template
# =============================================================================
# Copy to `.env` for local overrides:  copy .env.example .env
# This file documents variable NAMES and PLACEHOLDERS only. Real credentials
# belong in the git-ignored `.env` — NEVER commit real secrets.
# =============================================================================

# --- Service identity (non-secret; safe defaults in app/core/config.py) ---
APP_NAME=voxsearch-backend
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Supabase / PostgreSQL (Goal 05, connection-only) ---
# The backend connects via DATABASE_URL ONLY. The Supabase API keys below are
# NOT substitutes for PostgreSQL credentials and are not used by this goal.
# All values are PLACEHOLDERS — replace them only inside the git-ignored .env.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
# postgresql+psycopg:// selects the Psycopg 3 driver (no psycopg2 needed).
DATABASE_URL=postgresql+psycopg://your-user:your-password@your-host:6543/your-database

# --- YouTube Data API (Goal 34, authentication setup only) ---
# PLACEHOLDER ONLY. Put the real key in the git-ignored .env, never in source.
YOUTUBE_API_KEY=your-youtube-api-key-placeholder
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# --- Creator authorization (Goal 37, OAuth web-server flow) ---
# PLACEHOLDERS ONLY. Real values belong in the git-ignored .env.
OAUTH_CLIENT_ID=your-oauth-client-id-placeholder
OAUTH_CLIENT_SECRET=your-oauth-client-secret-placeholder
OAUTH_REDIRECT_URI=https://your-app.example/api/v1/auth/youtube/callback

# --- Redis queue setup (Goal 39) ---
# PLACEHOLDER ONLY. Real password belongs in the git-ignored .env.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password-placeholder
REDIS_QUEUE_KEY=voxsearch:jobs
