# =============================================================================
# VoxSearch backend — environment configuration template
# =============================================================================
# Copy to `.env` for local overrides:  copy .env.example .env
# This file documents variable NAMES and PLACEHOLDERS only. Real credentials
# belong in the git-ignored `.env` — NEVER commit real secrets.
# =============================================================================

# --- Service identity (non-secret; safe defaults in app/core/config.py) ---
APP_NAME=voxsearch-backend
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Supabase / PostgreSQL (Goal 05, connection-only) ---
# The backend connects via DATABASE_URL ONLY. The Supabase API keys below are
# NOT substitutes for PostgreSQL credentials and are not used by this goal.
# All values are PLACEHOLDERS — replace them only inside the git-ignored .env.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
# postgresql+psycopg:// selects the Psycopg 3 driver (no psycopg2 needed).
DATABASE_URL=postgresql+psycopg://your-user:your-password@your-host:6543/your-database
